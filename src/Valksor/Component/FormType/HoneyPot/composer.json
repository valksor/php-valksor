{
    "name": "valksor/php-form-type-honey-pot",
    "description": "Symfony Form type for honeypot spam protection",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "php",
        "symfony",
        "valksor"
    ],
    "homepage": "https://github.com/valksor/php-valksor",
    "require": {
        "php": ">=8.4",
        "symfony/config": "*",
        "symfony/dependency-injection": "*",
        "symfony/form": "*",
        "symfony/http-foundation": "*",
        "symfony/options-resolver": "*",
        "valksor/php-bundle": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": false,
    "autoload": {
        "psr-4": {
            "Valksor\\Component\\FormType\\HoneyPot\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
